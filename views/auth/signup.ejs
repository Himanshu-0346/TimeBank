<%- include('../partials/header') %>

<div class="auth-split">
  <div class="auth-left">
    <div style="font-size: 2rem; font-weight: 900; color: white; display: flex; align-items: center; gap: 0.5rem; position: absolute; top: 3rem; left: 4rem;">
      <i class="fa-solid fa-hourglass-half"></i> TimeBank.
    </div>
    <div style="max-width: 400px; margin-top: -5rem;">
      <h1 style="font-size: 3.5rem; font-weight: 900; line-height: 1.1; margin-bottom: 1.5rem; color: #38bdf8;">Join the<br>Community 🚀</h1>
      <p style="font-size: 1.3rem; line-height: 1.6; color: rgba(255,255,255,0.8);">Your skills are valuable. Sign up today and start earning credits by helping others.</p>
    </div>
  </div>
  
  <div class="auth-right">
    <div class="card" style="width: 100%; max-width: 500px; padding: 3rem 2.5rem; border: none; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.15);">
      <h2 class="mb-2" style="font-size: 2rem; font-weight: 800;">Create Account</h2>
      <p class="text-muted mb-4" style="font-size: 1.1rem;">It's free and always will be.</p>
      
      <% if (error) { %>
        <div class="alert alert-danger mb-4" style="padding: 1rem; font-size: 1rem;"><i class="fa-solid fa-triangle-exclamation"></i> <%= error %></div>
      <% } %>

      <form action="/auth/signup" method="POST">
        <div class="form-group mb-3">
          <label for="name">👤 Full Name</label>
          <input type="text" id="name" name="name" class="form-control" placeholder="e.g. Alice Wonder" required style="padding: 1rem 1.2rem;">
        </div>
        
        <div class="form-group mb-3">
          <label for="email">📧 Email Address</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="alice@example.com" required style="padding: 1rem 1.2rem;">
        </div>
        
        <div class="form-group mb-3">
          <label for="password">🔒 Password</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="Create a strong password" required style="padding: 1rem 1.2rem;">
        </div>

        <div class="form-group mb-4">
          <label for="skills">🛠️ Skills (Comma separated)</label>
          <input type="text" id="skills" name="skills" class="form-control" placeholder="e.g. design, plumbing, math" required style="padding: 1rem 1.2rem;">
        </div>
        
        <button type="submit" class="btn primary-btn w-100 mt-2" style="padding: 1.2rem; font-size: 1.2rem;">Sign Up <i class="fa-solid fa-user-plus"></i></button>
      </form>
      
      <p class="text-center mt-4" style="color: var(--text-muted); font-size: 1.05rem;">
        Already have an account? <a href="/auth/login" style="color: var(--primary-color); font-weight: 700; text-decoration: underline;">Log in</a>
      </p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
