<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-5">
  <div>
    <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--text-dark);">🎁 Reward Store</h1>
    <p class="text-muted" style="font-size: 1.2rem; margin: 0;">Exchange your hard-earned credits for exclusive coupons.</p>
  </div>
  
  <div class="card" style="padding: 1rem 2rem; border-left: 5px solid var(--warning-color); background: rgba(253, 203, 110, 0.1); display: flex; align-items: center; gap: 1.5rem;">
    <div>
      <p class="text-muted" style="font-size: 0.9rem; margin-bottom: 0.2rem; font-weight: 600; text-transform: uppercase;">Your Balance</p>
      <h2 style="font-size: 2rem; margin: 0; color: var(--warning-color);"><%= currentUser.credits %> <i class="fa-solid fa-coins"></i></h2>
    </div>
  </div>
</div>

<h2 class="mb-4" style="font-size: 1.8rem;">Available Coupons</h2>
<div class="grid-3 mb-5">
  <% if (coupons.length === 0) { %>
    <div class="card text-center w-100" style="grid-column: span 3; padding: 4rem;">
      <i class="fa-solid fa-box-open text-muted" style="font-size: 4rem; opacity: 0.5; margin-bottom: 1rem;"></i>
      <h3 class="text-muted">No coupons available at the moment.</h3>
    </div>
  <% } else { %>
    <% coupons.forEach(coupon => { %>
      <div class="card text-center" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
        <!-- Coupon Header / Graphic -->
        <div style="background: linear-gradient(135deg, var(--primary-color) 0%, #8e44ad 100%); color: white; padding: 3rem 1rem; position: relative;">
          <!-- Ticket notch effect -->
          <div style="position: absolute; bottom: -15px; left: -15px; width: 30px; height: 30px; background: var(--card-bg); border-radius: 50%;"></div>
          <div style="position: absolute; bottom: -15px; right: -15px; width: 30px; height: 30px; background: var(--card-bg); border-radius: 50%;"></div>
          
          <h2 style="color: white; font-size: 2.5rem; margin-bottom: 0.5rem; font-weight: 800;"><%= coupon.discountValue %></h2>
          <p style="margin: 0; font-size: 1.1rem; font-weight: 500; opacity: 0.9;"><%= coupon.name %></p>
        </div>
        
        <!-- Coupon Details -->
        <div style="padding: 2rem 1.5rem; flex: 1; display: flex; flex-direction: column;">
          <p class="text-muted mb-4" style="font-size: 1.05rem; line-height: 1.6; flex: 1;"><%= coupon.description %></p>
          
          <div style="border-top: 2px dashed var(--border-color); padding-top: 1.5rem; margin-bottom: 1.5rem;">
            <h3 style="color: var(--warning-color); font-size: 1.5rem;"><%= coupon.requiredCredits %> <i class="fa-solid fa-coins" style="font-size: 1.2rem;"></i></h3>
          </div>
          
          <form action="/rewards/claim/<%= coupon.id %>" method="POST">
            <button type="submit" class="btn primary-btn w-100" style="padding: 1.2rem; font-size: 1.1rem; <%= currentUser.credits < coupon.requiredCredits ? 'opacity: 0.5; cursor: not-allowed;' : '' %>" <%= currentUser.credits < coupon.requiredCredits ? 'disabled' : '' %>>
              <%= currentUser.credits < coupon.requiredCredits ? 'Not Enough Credits 🔒' : 'Claim Reward 🎉' %>
            </button>
          </form>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<h2 class="mb-4" style="font-size: 1.8rem;">My Wallet</h2>
<div class="grid-3">
  <% if (!myCoupons || myCoupons.length === 0) { %>
    <div class="card text-center w-100" style="grid-column: span 3; padding: 4rem;">
      <i class="fa-solid fa-wallet text-muted" style="font-size: 4rem; opacity: 0.5; margin-bottom: 1rem;"></i>
      <h3 class="text-muted">You haven't claimed any coupons yet.</h3>
    </div>
  <% } else { %>
    <% myCoupons.forEach(coupon => { %>
      <div class="card" style="border-left: 6px solid var(--success-color); display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div class="d-flex justify-content-between align-items-start mb-3">
            <h4 style="font-size: 1.2rem; margin: 0;"><%= coupon.name %></h4>
            <span class="badge badge-success"><%= coupon.discountValue %></span>
          </div>
          <p class="text-muted mb-4" style="font-size: 0.95rem;">Use this secure code at checkout on the provider's website to claim your discount.</p>
        </div>
        
        <div style="background: var(--bg-app); padding: 1rem; border-radius: var(--radius-sm); border: 1px dashed var(--success-color); text-align: center; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='rgba(0,184,148,0.1)'" onmouseout="this.style.background='var(--bg-app)'">
          <span style="font-family: monospace; font-size: 1.3rem; font-weight: 800; color: var(--success-color); letter-spacing: 2px;"><i class="fa-solid fa-ticket"></i> <%= coupon.code %></span>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<%- include('../partials/footer') %>
