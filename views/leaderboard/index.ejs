<%- include('../partials/header') %>

<div class="text-center mb-5" style="margin-top: 1rem;">
  <div style="display: inline-block; padding: 1rem; background: rgba(108, 92, 231, 0.1); border-radius: 50%; color: var(--primary-color); font-size: 2.5rem; margin-bottom: 1rem;">
    <i class="fa-solid fa-trophy"></i>
  </div>
  <h1 style="font-size: 3.5rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--text-dark);">Hall of Fame</h1>
  <p class="text-muted" style="font-size: 1.3rem;">Celebrating our most active and helpful community members. ✨</p>
</div>

<div class="grid-3" style="margin-top: 3rem;">
  <!-- Top Earners -->
  <div class="card" style="border-top: 5px solid var(--warning-color); padding: 2rem;">
    <h3 class="text-center mb-4" style="font-size: 1.5rem;"><i class="fa-solid fa-coins text-warning" style="margin-right: 0.5rem;"></i> Top Earners</h3>
    <div class="d-flex flex-column gap-3">
      <% if (topEarners.length === 0) { %>
        <p class="text-muted text-center">No data yet. Be the first! 🚀</p>
      <% } else { %>
        <% topEarners.forEach((user, index) => { %>
          <div class="list-item" style="padding: 0.8rem; border: none; background: <%= index < 3 ? 'rgba(253, 203, 110, 0.05)' : 'transparent' %>;">
            <div class="d-flex align-items-center gap-3 w-100">
              <div class="rank-badge <%= index === 0 ? 'rank-1' : index === 1 ? 'rank-2' : index === 2 ? 'rank-3' : '' %>"><%= index + 1 %></div>
              <img src="<%= user.avatar %>" class="list-avatar" alt="" style="margin: 0; width: 40px; height: 40px;">
              <a href="/profile/<%= user.id %>" style="color: var(--text-dark); text-decoration: none; font-weight: 600; font-size: 1.1rem; flex: 1;"><%= user.name %></a>
              <div class="badge badge-warning" style="font-size: 1rem;"><%= user.credits %> <i class="fa-solid fa-coins"></i></div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Most Helpful -->
  <div class="card" style="border-top: 5px solid var(--success-color); padding: 2rem;">
    <h3 class="text-center mb-4" style="font-size: 1.5rem;"><i class="fa-solid fa-hand-holding-heart text-success" style="margin-right: 0.5rem;"></i> Most Helpful</h3>
    <div class="d-flex flex-column gap-3">
      <% if (topHelpers.length === 0) { %>
        <p class="text-muted text-center">No data yet. Start helping! 🤝</p>
      <% } else { %>
        <% topHelpers.forEach((user, index) => { %>
          <div class="list-item" style="padding: 0.8rem; border: none; background: <%= index < 3 ? 'rgba(0, 184, 148, 0.05)' : 'transparent' %>;">
            <div class="d-flex align-items-center gap-3 w-100">
              <div class="rank-badge <%= index === 0 ? 'rank-1' : index === 1 ? 'rank-2' : index === 2 ? 'rank-3' : '' %>"><%= index + 1 %></div>
              <img src="<%= user.avatar %>" class="list-avatar" alt="" style="margin: 0; width: 40px; height: 40px;">
              <a href="/profile/<%= user.id %>" style="color: var(--text-dark); text-decoration: none; font-weight: 600; font-size: 1.1rem; flex: 1;"><%= user.name %></a>
              <div class="badge badge-success" style="font-size: 1rem;"><%= user.helpsCount %> Helps</div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Top Rated -->
  <div class="card" style="border-top: 5px solid var(--primary-color); padding: 2rem;">
    <h3 class="text-center mb-4" style="font-size: 1.5rem;"><i class="fa-solid fa-star text-primary" style="margin-right: 0.5rem;"></i> Top Rated</h3>
    <div class="d-flex flex-column gap-3">
      <% if (topRated.length === 0) { %>
        <p class="text-muted text-center">No data yet. Earn a review! ⭐</p>
      <% } else { %>
        <% topRated.forEach((user, index) => { %>
          <div class="list-item" style="padding: 0.8rem; border: none; background: <%= index < 3 ? 'rgba(108, 92, 231, 0.05)' : 'transparent' %>;">
            <div class="d-flex align-items-center gap-3 w-100">
              <div class="rank-badge <%= index === 0 ? 'rank-1' : index === 1 ? 'rank-2' : index === 2 ? 'rank-3' : '' %>"><%= index + 1 %></div>
              <img src="<%= user.avatar %>" class="list-avatar" alt="" style="margin: 0; width: 40px; height: 40px;">
              <a href="/profile/<%= user.id %>" style="color: var(--text-dark); text-decoration: none; font-weight: 600; font-size: 1.1rem; flex: 1;"><%= user.name %></a>
              <div class="badge" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b; font-size: 1rem;"><i class="fa-solid fa-star"></i> <%= user.ratingAvg %></div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
