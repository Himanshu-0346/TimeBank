// .env.example
// Environment variables template - WHAT IT DOES: Defines all required config

# Database (PostgreSQL with Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/timebank"
DATABASE_URL_POOL="postgresql://username:password@localhost:5432/timebank?schema=public&connection_limit=5"

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Session & Security
SESSION_SECRET="your_random_secret_key_here"
JWT_SECRET="your_jwt_secret_here"
NODE_ENV="development"

# Server
PORT=3000
HOST="localhost"

# Email (Optional - for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
EMAIL_FROM="noreply@timebank.com"

# Redis (Optional - for sessions/caching)
REDIS_URL="redis://localhost:6379"
